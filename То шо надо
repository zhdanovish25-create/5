void setup() {
    // Инициализация Serial
    Serial.begin(115200);
    while (!Serial);
    
    printToSerial("========================================\n");
    printToSerial("Люксметр на Arduino UNO с FreeRTOS\n");
    printToSerial("Лабораторная работа №5\n");
    printToSerial("========================================\n");
    
    // Инициализация дисплея
    lcd.init();
    lcd.backlight();
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Luxmeter v1.0");
    lcd.setCursor(0, 1);
    lcd.print("Initializing...");
    
    // Инициализация RTC
    initializeRTC();
    
    // Инициализация буфера усреднения
    for (int i = 0; i < AVG_BUFFER_SIZE; i++) {
        luxBuffer[i] = 0.0;
    }
    
    // Создание объектов синхронизации FreeRTOS
    xLuxQueue = xQueueCreate(10, sizeof(LuxData_t));
    xDisplayMutex = xSemaphoreCreateMutex();
    xSerialMutex = xSemaphoreCreateMutex();
    
    if (xLuxQueue == NULL || xDisplayMutex == NULL || xSerialMutex == NULL) {
        printToSerial("[ERROR] Failed to create RTOS objects!\n");
        lcd.clear();
        lcd.print("RTOS Error!");
        while (1); // Остановка при ошибке
    }
    
    // Вывод информации о системе
    printToSerial("System initialized\n");
    printToSerial("Calibration points: %d\n", CalibrationSize);
    printToSerial("Queue size: 10 elements\n");
    printToSerial("Measurement interval: 200 ms\n");
    printToSerial("========================================\n");
    
    // Обновление дисплея
    lcd.clear();
    lcd.print("FreeRTOS Ready");
    lcd.setCursor(0, 1);
    lcd.print("Starting tasks...");
    
    delay(1000);
    
    // Создание задач (с разными приоритетами)
    // 3 - высший приоритет (измерение)
    // 2 - средний приоритет (логирование)
    // 1 - низший приоритет (дисплей)
    xTaskCreate(vTaskMeasureLuminosity, "Measure", 256, NULL, 3, NULL);
    xTaskCreate(vTaskLogger, "Logger", 256, NULL, 2, NULL);
    xTaskCreate(vTaskDisplay, "Display", 256, NULL, 1, NULL);
    
    printToSerial("Tasks created successfully\n");
    printToSerial("FreeRTOS scheduler starting...\n");
    
    // Запуск планировщика FreeRTOS
    vTaskStartScheduler();
    
    // Если планировщик не запустился
    printToSerial("[ERROR] Failed to start scheduler!\n");
    while (1);
}о

