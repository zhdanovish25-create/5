#include <Arduino_FreeRTOS.h>
#include <queue.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <ThreeWire.h>  
#include <RtcDS1302.h>

// Глобальные хэндлы
QueueHandle_t xLuxQueue;

// Инициализация дисплея
LiquidCrystal_I2C lcd(0x27, 16, 2); // Адрес I2C, 16x2 дисплей

// Инициализация RTC DS1302
ThreeWire myWire(4, 5, 2); // DAT, CLK, RST
RtcDS1302<ThreeWire> Rtc(myWire);

// Пин фоторезистора
const int photoPin = A0;

// Структура для калибровочных данных
typedef struct {
  int adcValue;
  float luxValue;
} CalibrationPoint_t;

// Калибровочные данные из Таблицы 1
const CalibrationPoint_t CalibrationData[] = {
  {200, 10},    // N1
  {400, 150},   // N2
  {500, 300},   // N3
  {600, 500},   // N4
  {700, 750},   // N5
  {800, 1000},  // N6
  {850, 1200},  // N7
  {900, 1300},  // N8
  {950, 1400},  // N9
  {1000, 1500}  // N10
};

const int CALIBRATION_POINTS = 10;

// Прототипы функций
void vTaskMeasureLuminosity(void *pvParameters);
void vTaskDisplay(void *pvParameters);
void vTaskRTC(void *pvParameters);
float calculateLuxFromADC(int adcValue, const CalibrationPoint_t* calData);
void initializeRTC();
void printRTCStatus();

void setup() {
  Serial.begin(9600);
  
  // Инициализация LCD
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Initializing...");
  
  // Инициализация RTC
  initializeRTC();
  
  delay(2000);
  lcd.clear();

  // Создание очереди
  xLuxQueue = xQueueCreate(5, sizeof(float));

  if (xLuxQueue != NULL) {
    // Создание задач
    xTaskCreate(
      vTaskMeasureLuminosity,
      "Measure", 
      configMINIMAL_STACK_SIZE * 2,
      NULL,
      3,  // Высокий приоритет
      NULL
    );

    xTaskCreate(
      vTaskDisplay,
      "Display",
      configMINIMAL_STACK_SIZE * 2, 
      NULL,
      2,  // Средний приоритет
      NULL
    );

    xTaskCreate(
      vTaskRTC,
      "RTC_Print",
      configMINIMAL_STACK_SIZE * 2,
      NULL,
      1,  // Низкий приоритет
      NULL
    );

    // Запуск планировщика
    vTaskStartScheduler();
  } else {
    Serial.println("Ошибка создания очереди!");
    lcd.clear();
    lcd.print("Queue Error!");
  }
}

void loop() {
  // Пустой - всё управляется FreeRTOS
}

// Функция интерполяции
float calculateLuxFromADC(int adcValue, const CalibrationPoint_t* calData) {
  if (adcValue <= calData[0].adcValue) {
    return calData[0].luxValue;
  }
  
  if (adcValue >= calData[CALIBRATION_POINTS - 1].adcValue) {
    return calData[CALIBRATION_POINTS - 1].luxValue;
  }
  
  for (int i = 0; i < CALIBRATION_POINTS - 1; i++) {
    if (adcValue >= calData[i].adcValue && adcValue <= calData[i + 1].adcValue) {
      float ratio = (float)(adcValue - calData[i].adcValue) / 
                   (calData[i + 1].adcValue - calData[i].adcValue);
      return calData[i].luxValue + 
             ratio * (calData[i + 1].luxValue - calData[i].luxValue);
    }
  }
  
  return 0.0;
}

// Задача измерения освещенности
void vTaskMeasureLuminosity(void *pvParameters) {
  float luxValue = 0.0;
  
  for (;;) {
    int adcValue = analogRead(photoPin);
    
    // Интерполяция на основе калибровочных данных
    luxValue = calculateLuxFromADC(adcValue, CalibrationData);
    
    // Отправка данных в очередь
    if (xQueueSend(xLuxQueue, &luxValue, portMAX_DELAY) != pdPASS) {
      Serial.println("Ошибка отправки в очередь!");
    }
    
    vTaskDelay(pdMS_TO_TICKS(200)); // 200 мс
  }
}

// Задача дисплея (чтение из очереди)
void vTaskDisplay(void *pvParameters) {
    float receivedLux;
    unsigned long displayCounter = 0;
    
    for (;;) {
        // Блокирующее ожидание данных из очереди
        if (xQueueReceive(xLuxQueue, &receivedLux, portMAX_DELAY) == pdPASS) {
            // Вывод на LCD
            lcd.setCursor(0, 0);
            lcd.print("Lux: ");
            lcd.print(receivedLux, 1); // Вывод с 1 знаком после запятой
            lcd.print("     "); // Очистка хвоста
            
            // Чередующаяся информация на второй строке
            lcd.setCursor(0, 1);
            if (displayCounter % 4 == 0) {
                lcd.print("RTOS Active    ");
            } else if (displayCounter % 4 == 1) {
                lcd.print("ADC: ");
                lcd.print(analogRead(photoPin));
                lcd.print("     ");
            } else if (displayCounter % 4 == 2) {
                lcd.print("Queue OK       ");
            } else {
                lcd.print("FreeRTOS       ");
            }
            
            displayCounter++;
            
            // Вывод в Serial для отладки
            Serial.print("Display: Lux = ");
            Serial.print(receivedLux, 1);
            Serial.print(" lx | ADC = ");
            Serial.println(analogRead(photoPin));
        }
    }
}

// Задача RTC (чтение и вывод в Serial)
void vTaskRTC(void *pvParameters) {
    for (;;) {
        // Чтение времени с DS1302
        RtcDateTime now = Rtc.GetDateTime();
        
        // Вывод времени в Serial
        Serial.print("RTC Time: ");
        Serial.print(now.Year()); Serial.print("-");
        Serial.print(now.Month()); Serial.print("-");
        Serial.print(now.Day()); Serial.print(" ");
        Serial.print(now.Hour()); Serial.print(":");
        if (now.Minute() < 10) Serial.print("0");
        Serial.print(now.Minute()); Serial.print(":");
        if (now.Second() < 10) Serial.print("0");
        Serial.print(now.Second());
        Serial.println();
        
        vTaskDelay(pdMS_TO_TICKS(1000)); // Задержка 1 секунда
    }
}

// Инициализация RTC
void initializeRTC() {
    Serial.print("Initializing RTC... ");
    
    Rtc.Begin();
    
    // Проверка наличия RTC
    if (!Rtc.IsDateTimeValid()) {
        Serial.println("RTC lost confidence in the DateTime!");
        // Установка времени компиляции, если RTC не настроен
        RtcDateTime compiled = RtcDateTime(__DATE__, __TIME__);
        Rtc.SetDateTime(compiled);
    }
    
    if (!Rtc.GetIsRunning()) {
        Serial.println("RTC was not actively running, starting now");
        Rtc.SetIsRunning(true);
    }
    
    RtcDateTime now = Rtc.GetDateTime();
    if (now < RtcDateTime(2024, 1, 1, 0, 0, 0)) {
        Serial.println("RTC is set to a date before 2024, updating...");
        RtcDateTime compiled = RtcDateTime(__DATE__, __TIME__);
        Rtc.SetDateTime(compiled);
    }
    
    Serial.println("RTC initialized successfully");
}

// Функция для вывода статуса RTC
void printRTCStatus() {
    RtcTemperature temp = Rtc.GetTemperature();
    
    Serial.print("RTC Temperature: ");
    Serial.print(temp.AsFloatDegC());
    Serial.println(" C");
    
    // Проверка наличия RAM памяти RTC
    if (Rtc.GetIsWriteProtected()) {
        Serial.println("RTC is write protected");
    } else {
        Serial.println("RTC is not write protected");
    }
}
